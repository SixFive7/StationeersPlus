<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build-time helper. Emits the source-tree digest that TestRig.Cli bakes into the
    binary, using the SAME TestRig.Core implementation that the binary uses to
    recompute it at startup.

    That sharing is the point. An earlier design had a script compute the digest at
    build time and C# recompute it at run time, which meant two implementations that
    had to agree byte for byte forever, and a pairing test to police them. One
    implementation cannot disagree with itself.

    Not AOT and not shipped. It runs on the developer's machine during a build only.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>TestRig.BuildTool</AssemblyName>
    <RootNamespace>TestRig.BuildTool</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TestRig.Core\TestRig.Core.csproj" />
  </ItemGroup>

</Project>
