{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git commit*)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/research-commit-hook.ps1"
          },
          {
            "type": "command",
            "if": "Bash(*git commit*)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/site-commit-hook.ps1"
          },
          {
            "type": "command",
            "if": "Bash(*git commit*)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/web-commit-hook.ps1"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Read(*\\.mcp.json)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/playwright-config-hook.ps1"
          },
          {
            "type": "command",
            "if": "Read(*\\playwright\\README.md)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/playwright-config-hook.ps1"
          },
          {
            "type": "command",
            "if": "Read(*\\playwright\\LAUNCHER.md)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/playwright-config-hook.ps1"
          },
          {
            "type": "command",
            "if": "Read(*\\playwright\\launch.ps1)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/playwright-config-hook.ps1"
          },
          {
            "type": "command",
            "if": "Read(*\\playwright\\*\\config.json)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/playwright-config-hook.ps1"
          },
          {
            "type": "command",
            "if": "Read(*\\playwright\\*\\README.md)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/playwright-config-hook.ps1"
          },
          {
            "type": "command",
            "if": "Edit(*\\.mcp.json)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/playwright-config-hook.ps1"
          },
          {
            "type": "command",
            "if": "Edit(*\\playwright\\README.md)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/playwright-config-hook.ps1"
          },
          {
            "type": "command",
            "if": "Edit(*\\playwright\\LAUNCHER.md)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/playwright-config-hook.ps1"
          },
          {
            "type": "command",
            "if": "Edit(*\\playwright\\launch.ps1)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/playwright-config-hook.ps1"
          },
          {
            "type": "command",
            "if": "Edit(*\\playwright\\*\\config.json)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/playwright-config-hook.ps1"
          },
          {
            "type": "command",
            "if": "Edit(*\\playwright\\*\\README.md)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/playwright-config-hook.ps1"
          },
          {
            "type": "command",
            "if": "Write(*\\.mcp.json)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/playwright-config-hook.ps1"
          },
          {
            "type": "command",
            "if": "Write(*\\playwright\\README.md)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/playwright-config-hook.ps1"
          },
          {
            "type": "command",
            "if": "Write(*\\playwright\\LAUNCHER.md)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/playwright-config-hook.ps1"
          },
          {
            "type": "command",
            "if": "Write(*\\playwright\\launch.ps1)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/playwright-config-hook.ps1"
          },
          {
            "type": "command",
            "if": "Write(*\\playwright\\*\\config.json)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/playwright-config-hook.ps1"
          },
          {
            "type": "command",
            "if": "Write(*\\playwright\\*\\README.md)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/playwright-config-hook.ps1"
          }
        ]
      },
      {
        "matcher": "mcp__playwright-.+__browser_take_screenshot",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/playwright-screenshot-hook.ps1"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*testrig*)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/rig-hook.ps1"
          },
          {
            "type": "command",
            "if": "Bash(*savepath*)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/rig-hook.ps1"
          },
          {
            "type": "command",
            "if": "Bash(*requireIsolatedSavePath*)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/rig-hook.ps1"
          },
          {
            "type": "command",
            "if": "PowerShell(*testrig*)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/rig-hook.ps1"
          },
          {
            "type": "command",
            "if": "PowerShell(*savepath*)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/rig-hook.ps1"
          },
          {
            "type": "command",
            "if": "PowerShell(*requireIsolatedSavePath*)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/rig-hook.ps1"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "if": "Read(*decomp*)",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/research-hook-decompile.ps1"
          },
          {
            "type": "command",
            "if": "Glob(*decomp*)",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/research-hook-decompile.ps1"
          },
          {
            "type": "command",
            "if": "Glob(*rocketstation_Data/Managed/*)",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/research-hook-decompile.ps1"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/research-hook-decompile.ps1"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "if": "Read(*\\Research\\\\\\\\*)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/research-hook-read.ps1"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*\\Research\\\\\\\\*)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/research-hook-write.ps1"
          },
          {
            "type": "command",
            "if": "Write(*\\Research\\\\\\\\*)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/research-hook-write.ps1"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*\\Research\\\\\\\\*)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/web-publish-hook.ps1"
          },
          {
            "type": "command",
            "if": "Write(*\\Research\\\\\\\\*)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/web-publish-hook.ps1"
          },
          {
            "type": "command",
            "if": "Edit(*\\tools\\\\\\\\*)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/web-publish-hook.ps1"
          },
          {
            "type": "command",
            "if": "Write(*\\tools\\\\\\\\*)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/web-publish-hook.ps1"
          },
          {
            "type": "command",
            "if": "Edit(*\\Web\\content\\\\\\\\*)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/web-publish-hook.ps1"
          },
          {
            "type": "command",
            "if": "Write(*\\Web\\content\\\\\\\\*)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/web-publish-hook.ps1"
          },
          {
            "type": "command",
            "if": "Edit(*\\Web\\overrides\\\\\\\\*)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/web-publish-hook.ps1"
          },
          {
            "type": "command",
            "if": "Write(*\\Web\\overrides\\\\\\\\*)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/web-publish-hook.ps1"
          },
          {
            "type": "command",
            "if": "Edit(*\\Web\\mkdocs.yml)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/web-publish-hook.ps1"
          },
          {
            "type": "command",
            "if": "Write(*\\Web\\mkdocs.yml)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/web-publish-hook.ps1"
          },
          {
            "type": "command",
            "if": "Edit(*\\Web\\requirements.txt)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/web-publish-hook.ps1"
          },
          {
            "type": "command",
            "if": "Write(*\\Web\\requirements.txt)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/web-publish-hook.ps1"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*\\Web\\site\\\\\\\\*)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/web-site-edit-hook.ps1"
          },
          {
            "type": "command",
            "if": "Write(*\\Web\\site\\\\\\\\*)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/web-site-edit-hook.ps1"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Read(*\\Mods\\\\\\\\*\\README.md)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/mod-content-hook.ps1"
          },
          {
            "type": "command",
            "if": "Read(*\\Plans\\\\\\\\*\\README.md)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/mod-content-hook.ps1"
          },
          {
            "type": "command",
            "if": "Read(*\\About\\About.xml)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/mod-content-hook.ps1"
          },
          {
            "type": "command",
            "if": "Edit(*\\Mods\\\\\\\\*\\README.md)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/mod-content-hook.ps1"
          },
          {
            "type": "command",
            "if": "Edit(*\\Plans\\\\\\\\*\\README.md)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/mod-content-hook.ps1"
          },
          {
            "type": "command",
            "if": "Edit(*\\About\\About.xml)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/mod-content-hook.ps1"
          },
          {
            "type": "command",
            "if": "Write(*\\Mods\\\\\\\\*\\README.md)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/mod-content-hook.ps1"
          },
          {
            "type": "command",
            "if": "Write(*\\Plans\\\\\\\\*\\README.md)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/mod-content-hook.ps1"
          },
          {
            "type": "command",
            "if": "Write(*\\About\\About.xml)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/mod-content-hook.ps1"
          },
          {
            "type": "command",
            "if": "Read(*\\Mods\\\\\\\\*\\CHANGELOG.md)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/mod-content-hook.ps1"
          },
          {
            "type": "command",
            "if": "Read(*\\Plans\\\\\\\\*\\CHANGELOG.md)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/mod-content-hook.ps1"
          },
          {
            "type": "command",
            "if": "Edit(*\\Mods\\\\\\\\*\\CHANGELOG.md)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/mod-content-hook.ps1"
          },
          {
            "type": "command",
            "if": "Edit(*\\Plans\\\\\\\\*\\CHANGELOG.md)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/mod-content-hook.ps1"
          },
          {
            "type": "command",
            "if": "Write(*\\Mods\\\\\\\\*\\CHANGELOG.md)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/mod-content-hook.ps1"
          },
          {
            "type": "command",
            "if": "Write(*\\Plans\\\\\\\\*\\CHANGELOG.md)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/mod-content-hook.ps1"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*\\Mods\\\\\\\\*\\\\\\\\*\\Plugin.cs)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/release-hook.ps1"
          },
          {
            "type": "command",
            "if": "Write(*\\Mods\\\\\\\\*\\\\\\\\*\\Plugin.cs)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/release-hook.ps1"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Read(*\\TODO.md)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/todo-content-hook.ps1"
          },
          {
            "type": "command",
            "if": "Edit(*\\TODO.md)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/todo-content-hook.ps1"
          },
          {
            "type": "command",
            "if": "Write(*\\TODO.md)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/todo-content-hook.ps1"
          },
          {
            "type": "command",
            "if": "Read(*\\PLAYTEST.md)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/todo-content-hook.ps1"
          },
          {
            "type": "command",
            "if": "Edit(*\\PLAYTEST.md)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/todo-content-hook.ps1"
          },
          {
            "type": "command",
            "if": "Write(*\\PLAYTEST.md)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/todo-content-hook.ps1"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/web-stop-hook.ps1"
          },
          {
            "type": "command",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/rig-stop-hook.ps1"
          }
        ]
      }
    ]
  }
}
